{
  "name": "wings3-demo-lm-eval",
  "displayName": "WINGS3 demo — lm-eval-harness",
  "namespace": "my-first-model",
  "provider": "lm-eval-harness",
  "target": {
    "url": "http://llama-32-3b-instruct-predictor.my-first-model.svc.cluster.local:8080/v1",
    "model": "llama-32-3b-instruct"
  },
  "config": {
    "tasks": ["gsm8k"],
    "limit": 5,
    "tokenizer": "meta-llama/Llama-3.2-3B-Instruct",
    "num_examples": 10,
    "notes": "model_name is the vLLM API id; tokenizer is the HuggingFace id for lm-eval."
  }
}
