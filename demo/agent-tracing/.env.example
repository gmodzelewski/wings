# WINGS3 — KServe vLLM on this cluster (see walkthrough/partials/_attributes.md)
MAAS_API_KEY=unused
# Agent LLM — on cluster, MAAS_* come from Secret wings3-judge-llm (/etc/wings3-judge-llm).
MAAS_BASE_URL=http://llama-32-3b-instruct-predictor.my-first-model.svc.cluster.local:8080/v1
MAAS_MODEL=llama-32-3b-instruct
MAAS_API_KEY=unused

# Paste mlflow_ui from walkthrough/partials/_attributes.md (Today's cluster).
MLFLOW_TRACKING_URI=
MLFLOW_WORKSPACE=my-first-model
MLFLOW_EXPERIMENT_NAME=wings3-agent-tracing
MLFLOW_TRACKING_INSECURE_TLS=true

# Laptop rehearsal only (appendix): export MLFLOW_TRACKING_TOKEN=$(oc whoami --show-token)

# Module 4 judges — hosted MaaS (Secret wings3-judge-llm on cluster).
# Do not commit a real JUDGE_API_KEY. Alternatives: deepseek-r1-distill-qwen-14b, llama-scout-17b
JUDGE_BASE_URL=https://REPLACE_AT_INSTALL/llm/gpt-oss-120b/v1
JUDGE_MODEL=gpt-oss-120b
JUDGE_API_KEY=
